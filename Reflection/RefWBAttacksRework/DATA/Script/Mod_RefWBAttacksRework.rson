      "Operations":      
      [
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -50,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  5,
          "Code.Type":  "Global",
          "Code":          
          [
              "GRun();",
              "",
              "//Значения инфошки RefWBInfo",
              "//1 - Коалиция отбила систему, ожидает достижения в системе минимально нужного количества военных, чтобы КВСМК посчитало её защищённой",
              "//2 - Условие выполнено, военка смотрит, надо ли ей лететь домой",
              "//3 - Дома военки нету - надо лететь домой. Созывает всех вояк"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -10,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  6,
          "Code.Type":  "Turn",
          "Code":          
          [
              "launch = 0;",
              "for(i=PlanetNews()-1;i>=0;i=i-1) { //новости с 0 до PlanetNews()-1",
              "    if(PlanetNewsDate(i)<CurTurn()) continue;",
              "    if(PlanetNewsType(i) == 45) {",
              "        launch = 1;",
              "        break;",
              "    }",
              "}",
              "if(launch) {",
              "    tdwd = 0;",
              "    for(i=0;GalaxyStars()>i;i=i+1) {",
              "        star = GalaxyStar(i);",
              "        for(j=0;StarShips(star)>j;j=j+1) {",
              "            dword ship = StarShips(star,j);",
              "            if(!ShipInGameEvent(ship)) continue;",
              "            if(ShipFindCustomShipInfoByType(ship,'RefAttackerInfo') != -1) continue; //-1 = инфошки нет (раньше пропускались ВСЕ)",
              "            if(ShipFindCustomShipInfoByType(ship,'RefWBInfo') != -1) continue;",
              "            if(ShipInCurScript(ship)) continue;",
              "",
              "            if(ShipTypeN(ship) == t_WB) {",
              "                ShipAddCustomShipInfo(ship,'RefWBInfo','NoShow');",
              "                ShipJoin('GroupWB',ship);",
              "                ArrayAdd(WBarr,Id(ship));",
              "                ArrayAdd(BaseSysArr,Id(ShipStar(ship))); //Id звезды; звезда = GalaxyStar(Id-1)",
              "                tdwd = ship;",
              "            }",
              "        }",
              "    }",
              "    if(tdwd) {",
              "        for(i=0;GalaxyStars()>i;i=i+1) {",
              "            star = GalaxyStar(i);",
              "            for(j=0;StarShips(star)>j;j=j+1) {",
              "                ship = StarShips(star,j);",
              "                if(!ShipInGameEvent(ship)) continue;",
              "                if(ShipFindCustomShipInfoByType(ship,'RefAttackerInfo') != -1) continue;",
              "                if(ShipFindCustomShipInfoByType(ship,'RefWBInfo') != -1) continue;",
              "                if(ShipInCurScript(ship)) continue;",
              "",
              "                if(ShipTypeN(ship) == t_Warrior) {",
              "                    //база своей системы, иначе - последняя найденная (раньше все бойцы - к последней)",
              "                    twb = tdwd;",
              "                    for(k=0;StarShips(star)>k;k=k+1) {",
              "                        if(ShipTypeN(StarShips(star,k)) == t_WB && ShipFindCustomShipInfoByType(StarShips(star,k),'RefWBInfo') != -1) twb = StarShips(star,k);",
              "                    }",
              "                    ShipAddCustomShipInfo(ship,'RefAttackerInfo','NoShow');",
              "                    ShipJoin('GroupWarriors',ship);",
              "                    ShipCustomShipInfoTextData(ship,'RefAttackerInfo',1,Id(twb));",
              "                }",
              "            }",
              "        }",
              "    }",
              "}"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  130,
          "Pos.y":  280,
          "Parent":  -1,
          "#":  16,
          "Code.Type":  "Turn",
          "Code":          
          [
              "if(!GetShipRuins(CurShip) || !WBOf(CurShip)) { //база погибла/вне скрипта или боец уже не на ней",
              "    OrderLock(CurShip,0);",
              "    ShipOut(CurShip);",
              "    ShipDeleteCustomShipInfo(CurShip,'RefAttackerInfo');",
              "}",
              "else if(ShipInNormalSpace(GetShipRuins(CurShip))) {",
              "    if(StarOwner(ShipStar(GetShipRuins(CurShip))) == 0) {",
              "        OrderLock(CurShip,0);",
              "        ShipOut(CurShip);",
              "        ShipDeleteCustomShipInfo(CurShip,'RefAttackerInfo');",
              "    }",
              "}"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  10,
          "Pos.y":  60,
          "Parent":  -1,
          "#":  17,
          "Code.Type":  "Turn",
          "Code":          
          [
              "k = ArrayFind(WBarr,Id(CurShip));",
              "if(k < 0) {",
              "    OrderLock(CurShip,0);",
              "    ShipOut(CurShip);",
              "}",
              "else {",
              "    tbase = GalaxyStar(BaseSysArr[k]-1); //в массиве Id звезды (раньше Id использовался как звезда)",
              "    if(ShipStar(CurShip) != tbase) {",
              "        if(!StarOwner(ShipStar(CurShip))) {",
              "            if(!ShipCustomShipInfoData(CurShip,'RefWBInfo',1)) ShipCustomShipInfoData(CurShip,'RefWBInfo',1,1);",
              "        }",
              "    }",
              "    if(ShipCustomShipInfoData(CurShip,'RefWBInfo',1) == 2) {",
              "        int need = 0;",
              "        for(i=0;ConStars(StarToCon(tbase))>i;i=i+1) {",
              "            for(j=0;StarShips(ConStar(StarToCon(tbase),i))>j;j=j+1) {",
              "                if(ShipType(StarShips(ConStar(StarToCon(tbase),i),j)) == 'WB') need = need + 1;",
              "            }",
              "        }",
              "        if(need > 0) { //в родном секторе есть ВБ - остаёмся в освобождённой системе",
              "            OrderLock(CurShip,0);",
              "            ShipOut(CurShip);",
              "        }",
              "        else { //дома ВБ нет - созываем бойцов и возвращаемся",
              "            ShipCustomShipInfoData(CurShip,'RefWBInfo',1,3);",
              "            ShipCustomShipInfoData(CurShip,'RefWBInfo',2,0); //летящие назад бойцы",
              "            ShipCustomShipInfoData(CurShip,'RefWBInfo',3,3); //дни ожидания",
              "        }",
              "    }",
              "    if(ShipCustomShipInfoData(CurShip,'RefWBInfo',1) == 3) {",
              "        ShipCustomShipInfoData(CurShip,'RefWBInfo',3,ShipCustomShipInfoData(CurShip,'RefWBInfo',3)-1);",
              "        //ждём, пока сядут все созванные (раньше счётчик писался не в ту ячейку и база не улетала); погибших ждём не дольше 30 дней",
              "        if((ShipCustomShipInfoData(CurShip,'RefWBInfo',3) <= 0 && ShipCustomShipInfoData(CurShip,'RefWBInfo',2) <= 0) || ShipCustomShipInfoData(CurShip,'RefWBInfo',3) <= -30) {",
              "            OrderLock(CurShip,1);",
              "            OrderTeleport(CurShip,tbase,CoordX(CurShip),CoordY(CurShip)); //было без координат - ошибка скрипта",
              "            ShipCustomShipInfoData(CurShip,'RefWBInfo',1,4);",
              "        }",
              "    }",
              "    if(ShipCustomShipInfoData(CurShip,'RefWBInfo',1) == 4) {",
              "        if(ShipInNormalSpace(CurShip) && ShipStar(CurShip) == tbase) { //уже дома (раньше отпускалась в тот же ход, до прыжка)",
              "            OrderLock(CurShip,0);",
              "            ShipOut(CurShip);",
              "        }",
              "    }",
              "}"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  130,
          "Pos.y":  150,
          "Parent":  -1,
          "#":  22,
          "Code.Type":  "Turn",
          "Code":          
          [
              "twb = WBOf(CurShip);",
              "if(!twb) {",
              "    OrderLock(CurShip,0);",
              "    ShipOut(CurShip);",
              "    ShipDeleteCustomShipInfo(CurShip,'RefAttackerInfo');",
              "}",
              "else if(!ShipInStar(twb,ShipStar(CurShip))) {",
              "    OrderLock(CurShip,1);",
              "    OrderJump(CurShip,ShipStar(twb),100); //было ShipJump - это дальность прыжка, а не приказ",
              "}",
              "else {",
              "    OrderLock(CurShip,1);",
              "    OrderLanding(CurShip,twb,100);",
              "}"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  10,
          "Pos.y":  150,
          "Parent":  -1,
          "#":  28,
          "Code.Type":  "Turn",
          "Code":          
          [
              "if(ShipInNormalSpace(CurShip)) {",
              "    if(!StarOwner(GalaxyStar(BaseSysArr[ArrayFind(WBarr,Id(CurShip))]-1))) { //Id звезды -> звезда",
              "        if(GetShipRuins(Player())) {",
              "            if(GetShipRuins(Player()) == CurShip) OrderTakeOff(Player());",
              "        }",
              "        OrderLock(CurShip,1);",
              "        ShipDestination(CurShip,GalaxyStar(BaseSysArr[ArrayFind(WBarr,Id(CurShip))]-1),CurTurn());",
              "    }",
              "    else {",
              "        for(i=0;GalaxyStars()>i;i=i+1) {",
              "            if(!StarOwner(GalaxyStar(i))) {",
              "                if(GetShipRuins(Player())) {",
              "                    if(GetShipRuins(Player()) == CurShip) OrderTakeOff(Player());",
              "                }",
              "                OrderLock(CurShip,1);",
              "                ShipDestination(CurShip,GalaxyStar(i),CurTurn());",
              "                break;",
              "            }",
              "        }",
              "    }",
              "}"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  30,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  29,
          "Code.Type":  "Init",
          "Code":          
          [
              "function WBActCode() { //t_OnTakingDamage,t_OnTakingDamageEn,t_OnTakingDamageSp,t_OnTakingDamageMi",
              "    //Станция телепортируется! Не время умирать!",
              "    ScriptItemActParam(0);",
              "}",
              "",
              "//База бойца, если она жива и ещё в скрипте, иначе 0",
              "function WBOf(dword ship) {",
              "    dword wb = IdToShip(ShipCustomShipInfoTextData(ship,'RefAttackerInfo',1));",
              "    result = 0;",
              "    if(~wb) {",
              "        if(wb) {",
              "            if(ShipInCurScript(wb)) result = wb;",
              "        }",
              "    }",
              "}",
              "",
              "//Фаза базы бойца (0, если базы нет)",
              "function WBPhase(dword ship) {",
              "    dword wb = WBOf(ship);",
              "    result = 0;",
              "    if(wb) result = ShipCustomShipInfoData(wb,'RefWBInfo',1);",
              "}"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  10,
          "Pos.y":  210,
          "Parent":  -1,
          "#":  32,
          "Code.Type":  "Turn",
