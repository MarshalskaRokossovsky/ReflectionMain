              "twb = WBOf(CurShip);",
              "if(twb) ShipCustomShipInfoData(twb,'RefWBInfo',2,ShipCustomShipInfoData(twb,'RefWBInfo',2)+1); //летит назад"
          ]        
        },
        {
          "Type":  "Top",
