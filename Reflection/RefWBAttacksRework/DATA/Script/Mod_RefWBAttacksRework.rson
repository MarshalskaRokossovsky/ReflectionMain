          "#":  35,
          "Code.Type":  "Turn",
          "Code":          
          [
              "//Базы больше нет в скрипте (погибла, отступила, осталась в новой системе) - боец свободен",
              "//(раньше условие было перевёрнуто: отпускало бойцов живой базы)",
              "OrderLock(CurShip,0);",
              "ShipOut(CurShip);",
              "ShipDeleteCustomShipInfo(CurShip,'RefAttackerInfo');"
          ]        
        },
