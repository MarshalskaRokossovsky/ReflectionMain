        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -50,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  5,
          "Code.Type":  "Global",
          "Code":          
          [
              "GRun();"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  30,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  6,
          "Code.Type":  "Turn",
          "Code":          
          [
              "//Навешиваем игроку инфу, что он тут наубивал (перед прыжком/телепортом)",
              "if(ShipInNormalSpace(Player())) {",
              "    if(StarOwner(ShipStar(Player()))) {",
              "        if(ShipOrder(Player()) == 3 || ShipOrder(Player()) == 4 || ShipOrder(Player()) == 7) {",
              "            if(ShipOrderData1(Player()) < 2) {",
              "                KillStore(ShipStar(Player()), ShipKillFactionInCurSystem(Player(),2), DomikKilledInCurSystem(Player()), ShipKillFactionInCurSystem(Player(),-1), ShipKillFactionInCurSystem(Player(),0));",
              "            }",
              "        }",
              "    }",
              "}",
              "",
              "//При влёте из гипера (или после телепорта) в какую-то систему - выдаём игроку убитых",
              "if(ShipInHyperSpace(Player()) || ShipOrder(Player()) == 7) InHyp = 1;",
              "",
              "if(InHyp) {",
              "    if(ShipInNormalSpace(Player())) {",
              "        //Пока висит приказ на телепорт - игрок ещё в старой системе, ждём прилёта",
              "        if(ShipOrder(Player()) != 7) {",
              "            InHyp = 0;",
              "            KillRestore(ShipStar(Player()));",
              "        }",
              "    }",
              "}",
              "",
              "//Перебираем куладауны убитых (лишний вызов тёрна перед взлётом пропускаем)",
              "if(!ShipIsTakeoff(Player())) KillTick();"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -10,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  7,
          "Code.Type":  "Init",
          "Code":          
          [
              "//Хранилище убитых по системам: параллельные массивы, запись = один индекс во всех шести.",
              "//Свободная ячейка - KillStars[i] == 0. Вложенные именованные массивы не используем:",
              "//ArrayFind по многомерным массивам не ищет, а читать несуществующий ключ ['Days'] = краш.",
              "",
              "//Записать (обновить) убитых для системы star; нулевые счётчики запись освобождают",
              "function KillStore(dword star, int pirates, domiks, others, coal) {",
              "    int slot;",
              "    int total;",
              "    total = pirates + domiks + others + coal;",
              "    slot = ArrayFind(KillStars, star);",
              "    if(~slot) {",
              "        if(total) {",
              "            KillDays[slot] = 31;",
              "            KillPirates[slot] = pirates;",
              "            KillDomiks[slot] = domiks;",
              "            KillOthers[slot] = others;",
              "            KillCoal[slot] = coal;",
              "        } else {",
              "            KillStars[slot] = 0;",
              "        }",
              "    } else if(total) {",
              "        slot = ArrayFind(KillStars, 0);",
              "        if(~slot) {",
              "            KillStars[slot] = star;",
              "            KillDays[slot] = 31;",
              "            KillPirates[slot] = pirates;",
              "            KillDomiks[slot] = domiks;",
              "            KillOthers[slot] = others;",
              "            KillCoal[slot] = coal;",
              "        } else {",
              "            ArrayAdd(KillStars, star);",
              "            ArrayAdd(KillDays, 31);",
              "            ArrayAdd(KillPirates, pirates);",
              "            ArrayAdd(KillDomiks, domiks);",
              "            ArrayAdd(KillOthers, others);",
              "            ArrayAdd(KillCoal, coal);",
              "        }",
              "    }",
              "}",
              "",
              "//Вернуть игроку убитых в системе star (если они были записаны) и освободить запись",
              "function KillRestore(dword star) {",
              "    int slot;",
              "    slot = ArrayFind(KillStars, star);",
              "    if(~slot) {",
              "        ShipKillFactionInCurSystem(Player(),-1,KillOthers[slot]);",
              "        ShipKillFactionInCurSystem(Player(),0,KillCoal[slot]);",
              "        ShipKillFactionInCurSystem(Player(),1,KillDomiks[slot]);",
              "        ShipKillFactionInCurSystem(Player(),2,KillPirates[slot]);",
              "        KillStars[slot] = 0;",
              "    }",
              "}",
              "",
              "//Ежедневный куладаун записей",
              "function KillTick() {",
              "    int k;",
              "    for(k=0;ArrayDim(KillStars)>k;k=k+1) {",
              "        if(KillStars[k]) {",
              "            KillDays[k] = KillDays[k] - 1;",
              "            if(KillDays[k] <= 0) KillStars[k] = 0;",
              "        }",
              "    }",
              "}"
          ]        
        }      
      ],
