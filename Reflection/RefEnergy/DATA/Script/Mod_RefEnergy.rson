            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -50,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 5,
                    "Code.Type": "Global",
                    "Code": [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -10,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "DialogBegin",
                    "Code": [
                        "if(GetShipRuins(Player())) {",
                        "    if(!PlayerBridge()) {",
                        "        //Энергоядро ставят на ТЦ (ExpTC), а без ExpTC — на научных базах",
                        "        if(ShipType(GetShipRuins(Player())) == 'TC' || (ShipType(GetShipRuins(Player())) == 'SB' && !CurrentMods('Expansion\\ExpTC'))) {",
                        "            AddDialogInject('DialogCore','',CT('Script.Mod_RefEnergy.InjectCore'),10);",
                        "        }",
                        "",
                        "        if(ShipType(GetShipRuins(Player())) == 'TC' || ShipType(GetShipRuins(Player())) == 'SB') {",
                        "            tint1 = 0;",
                        "            for(i = 0; i < ShipItems(Player()); i = i + 1)",
                        "            {",
                        "                cur_item = ShipItems(Player(), i);",
                        "                if(ItemType(cur_item) != t_UselessItem) continue;",
                        "                if(EquipmentImageName(cur_item) != 'RefEnergy_Battery') continue;",
                        "                if(UselessItemData(cur_item,1) >= UselessItemData(cur_item,2)) continue;",
                        "                //Считаем количество батарей на борту",
                        "                tint1 = tint1 + 1;",
                        "            }",
                        "            if(tint1) AddDialogInject('DialogBattery','',CT('Script.Mod_RefEnergy.InjectBattery'),5);",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -50,
                    "Pos.y": -130,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Turn",
                    "Code": [
                        "//Раздаём новым кораблям энергоблоки и инфошку третона",
                        "if(GalaxyShipId() > lastShipId) {",
                        "    int cnt=BuildListOfNewShips(tarr1,lastShipId,1+2+4+8+16+256+4096+8192,1+2+4+8+16+128,1,'');",
                        "    if(cnt) {",
                        "        for(i=0;i<ArrayDim(tarr1);i=i+1) {",
                        "            cur_ship=tarr1[i];",
                        "            if(IsPlayer(cur_ship)) continue;",
                        "            if(ShipOwner(cur_ship) == Kling) continue;",
                        "            if(RndObject(1,100,cur_ship) < 5) {",
                        "                //Раздаём энергоблоки, ёмкость по техуровню корпуса",
                        "                int rand = RndObject(1,100,cur_ship);",
                        "                int hlvl = ItemLevel(ShipEqInSlot(cur_ship,t_Hull));",
                        "                int cap = 30;",
                        "                if(hlvl == 2) cap = 45;",
                        "                if(hlvl == 3) cap = 60;",
                        "                if(hlvl == 4) cap = 70;",
                        "                if(hlvl == 5) cap = 90;",
                        "                if(hlvl == 6) cap = 110;",
                        "                if(hlvl == 7) cap = 130;",
                        "                if(hlvl >= 8) cap = 150;",
                        "                item = CreateQuestItem('RefEnergy_Battery',ShipOwner(cur_ship));",
                        "                UselessItemData(item,2,cap);",
                        "                if(rand < 6) UselessItemData(item,1,round(cap * Rnd(0,20) / 100));",
                        "                else if(rand < 71) UselessItemData(item,1,round(cap * Rnd(20,60) / 100));",
                        "                else if(rand < 96) UselessItemData(item,1,round(cap * Rnd(60,90) / 100));",
                        "                else UselessItemData(item,1,round(cap * Rnd(90,100) / 100));",
                        "                ShipAddDropItem(cur_ship,item);",
                        "            }",
                        "            //Инфошка третона (стреляющий третоном накладывает дебафф), без дублей",
                        "            if(ShipFindCustomShipInfoByType(cur_ship,'RefEnergyTretonInfo') == -1) ShipAddCustomShipInfo(cur_ship,'RefEnergyTretonInfo','NoShow');",
                        "        }",
                        "    }",
                        "    lastShipId = GalaxyShipId();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -10,
                    "Pos.y": -130,
                    "Parent": -1,
                    "#": 8,
                    "Code.Type": "Init",
                    "Code": [
                        "if(ShipFindCustomShipInfoByType(Player(),'RefEnergyInfo') == -1) ShipAddCustomShipInfo(Player(),'RefEnergyInfo');",
                        "if(ShipFindCustomShipInfoByType(Player(),'RefEnergyBuffInfo') == -1) ShipAddCustomShipInfo(Player(),'RefEnergyBuffInfo','NoShow');",
                        "",
                        "//Первичный перебор галактики (игрока пропускаем)",
                        "for(i=0;GalaxyStars()>i;i=i+1) {",
                        "    for(j=0;StarShips(GalaxyStar(i))>j;j=j+1) {",
                        "        cur_ship = StarShips(GalaxyStar(i),j);",
                        "        if(IsPlayer(cur_ship)) continue;",
                        "        if(ShipOwner(cur_ship) == Kling) continue;",
                        "        if(RndObject(1,100,cur_ship) < 5) {",
                        "            //Раздаём энергоблоки, ёмкость по техуровню корпуса",
                        "            int rand = RndObject(1,100,cur_ship);",
                        "            int hlvl = ItemLevel(ShipEqInSlot(cur_ship,t_Hull));",
                        "            int cap = 30;",
                        "            if(hlvl == 2) cap = 45;",
                        "            if(hlvl == 3) cap = 60;",
                        "            if(hlvl == 4) cap = 70;",
                        "            if(hlvl == 5) cap = 90;",
                        "            if(hlvl == 6) cap = 110;",
                        "            if(hlvl == 7) cap = 130;",
                        "            if(hlvl >= 8) cap = 150;",
                        "            item = CreateQuestItem('RefEnergy_Battery',ShipOwner(cur_ship));",
                        "            UselessItemData(item,2,cap);",
                        "            if(rand < 6) UselessItemData(item,1,round(cap * Rnd(0,20) / 100));",
                        "            else if(rand < 71) UselessItemData(item,1,round(cap * Rnd(20,60) / 100));",
                        "            else if(rand < 96) UselessItemData(item,1,round(cap * Rnd(60,90) / 100));",
                        "            else UselessItemData(item,1,round(cap * Rnd(90,100) / 100));",
                        "            ShipAddDropItem(cur_ship,item);",
                        "        }",
                        "        //Инфошка третона (стреляющий третоном накладывает дебафф), без дублей",
                        "        if(ShipFindCustomShipInfoByType(cur_ship,'RefEnergyTretonInfo') == -1) ShipAddCustomShipInfo(cur_ship,'RefEnergyTretonInfo','NoShow');",
                        "    }",
                        "}",
                        "//Уже обработанные корабли не должны снова попасть в Turn",
                        "lastShipId = GalaxyShipId();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 140,
                    "Pos.y": 10,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Turn",
                    "Code": [
                        "size = 200 - (GalaxyTechLevel() * 15);",
                        "money = GalaxyMoney(4) * GalaxyDiffLevels(4) / 50;",
                        "dlgStr1 = '</color>' + Format(CT('Script.Mod_RefEnergy.CoreOffer'),'<Money'+'>',money,'<Size'+'>',size);",
                        "dlgStr2 = '</color>' + CT('Script.Mod_RefEnergy.AnsCoreInstall');",
                        "dlgStr3 = '</color>' + CT('Script.Mod_RefEnergy.AnsCoreInstall');",
                        "dlgStr4 = '</color>' + CT('Script.Mod_RefEnergy.AnsCoreLater');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 140,
                    "Pos.y": 170,
                    "Parent": -1,
                    "#": 29,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(ItemExtraSpecialsCountByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore1'))) {",
                        "    ItemExtraSpecialsDeleteByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore1'));",
                        "    ItemExtraSpecialsAddByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore2'));",
                        "}",
                        "else if(ItemExtraSpecialsCountByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore2'))) {",
                        "    ItemExtraSpecialsDeleteByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore2'));",
                        "    ItemExtraSpecialsAddByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore3'));",
                        "}",
                        "else {",
                        "    ItemExtraSpecialsAddByType(ShipEqInSlot(Player(),t_Hull),FindBonusByNameInCfg('RefEnergy_ExtraCore1'));",
                        "}",
                        "",
                        "Sound('Sound.Buy');",
                        "ShipMoney(Player(),ShipMoney(Player()) - money);",
                        "ItemSize(ShipEqInSlot(Player(),t_Hull),ItemSize(ShipEqInSlot(Player(),t_Hull)) - size);",
                        "dlgStr1 = '</color>' + CT('Script.Mod_RefEnergy.CoreDone');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 370,
                    "Pos.y": -110,
                    "Parent": -1,
                    "#": 33,
                    "Code.Type": "Turn",
                    "Code": [
                        "dlgStr1 = '</color>' + CT('Script.Mod_RefEnergy.BatteryList');",
                        "dlgStr2 = '</color>' + CT('Script.Mod_RefEnergy.AnsBatteryNo');",
                        "tint1 = 0;",
                        "for(i = 0; i < ShipItems(Player()); i = i + 1)",
                        "{",
                        "    cur_item = ShipItems(Player(), i);",
                        "    if(ItemType(cur_item) != t_UselessItem) continue;",
                        "    if(EquipmentImageName(cur_item) != 'RefEnergy_Battery') continue;",
                        "    if(UselessItemData(cur_item,1) >= UselessItemData(cur_item,2)) continue;",
                        "    tint1 = tint1 + 1;",
                        "    //Тег - префиксом в тексте ответа (раньше теги block/snap уходили 4-м аргументом = код действия, в Dword-переменной:",
                        "    //не хватает денег - ответ всё равно активен)",
                        "    dlgStr4 = '';",
                        "    if((GalaxyMoney(2) * (UselessItemData(cur_item,2) - UselessItemData(cur_item,1))) > ShipMoney(Player())) dlgStr4 = 'block~';",
                        "    InjectAnswer('DialogNew',dlgStr4+Format(CT('Script.Mod_RefEnergy.BatteryItem'),'<Weight'+'>',ItemSize(cur_item),'<On'+'>',UselessItemData(cur_item,1),'<Off'+'>',UselessItemData(cur_item,2),'<Cost'+'>',(GalaxyMoney(2) * (UselessItemData(cur_item,2) - UselessItemData(cur_item,1)))),cur_item);",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 470,
                    "Pos.y": -70,
                    "Parent": -1,
                    "#": 39,
                    "Code.Type": "Turn",
                    "Code": [
                        "Sound('Sound.Buy');",
                        "ShipMoney(Player(),ShipMoney(Player())-(GalaxyMoney(2) * (UselessItemData(GAnswerData,2) - UselessItemData(GAnswerData,1))));",
                        "UselessItemData(GAnswerData,1,UselessItemData(GAnswerData,2));",
                        "tint1 = tint1 - 1;",
                        "dlgStr1 = '</color>' + CT('Script.Mod_RefEnergy.BatteryDone');",
                        "dlgStr2 = '</color>' + CT('Script.Mod_RefEnergy.AnsBatteryEnd');",
                        "dlgStr3 = '</color>' + CT('Script.Mod_RefEnergy.AnsBatteryMore');"
                    ]
                },
