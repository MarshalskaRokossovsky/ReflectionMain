          "Code.Type":  "Global",
          "Code":          
          [
              "if(!GCntRun(GScriptName)) GRun();"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -10,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  6,
          "Total.Lines":  33,
          "Code.Type":  "Init",
          "Code":          
          [
              "int rand;",
              "for(i=0;GalaxyStars() > i;i=i+1) {",
              "    for(j=0;StarPlanets(GalaxyStar(i)) > j;j=j+1) {",
              "        if(PlanetOwner(StarPlanets(GalaxyStar(i),j)) == 6) {",
              "            rand = Rnd(1,5);",
              "            // В родных системах заселяем всё своими же (раньше случайная раса ниже перезаписывала родную)",
              "            if(Name(GalaxyStar(i)) == substr(CT('Star.00'),0,findsubstr(CT('Star.00'),','))) rand = 1;",
              "            if(Name(GalaxyStar(i)) == substr(CT('Star.01'),0,findsubstr(CT('Star.01'),','))) rand = 2;",
              "            if(Name(GalaxyStar(i)) == substr(CT('Star.02'),0,findsubstr(CT('Star.02'),','))) rand = 3;",
              "            if(Name(GalaxyStar(i)) == substr(CT('Star.03'),0,findsubstr(CT('Star.03'),','))) rand = 4;",
              "            if(Name(GalaxyStar(i)) == substr(CT('Star.04'),0,findsubstr(CT('Star.04'),','))) rand = 5;",
              "            PlanetRace(StarPlanets(GalaxyStar(i),j),rand - 1);",
              "            if(StarOwner(GalaxyStar(i)) == 1) PlanetOwner(StarPlanets(GalaxyStar(i),j),5);",
              "            if(StarOwner(GalaxyStar(i)) == 2) PlanetOwner(StarPlanets(GalaxyStar(i),j),7);",
              "            if(StarOwner(GalaxyStar(i)) == 0) PlanetOwner(StarPlanets(GalaxyStar(i),j),rand - 1); //Ну Коалиция, ну какого фига у тебя каждая раса - отдельный владелец?",
              "        }",
              "    }",
              "}",
              "//Простой перебор всех систем с небольшой рандомизацией того, какой расы выйдет планета"
          ]        
        }      
      ],
