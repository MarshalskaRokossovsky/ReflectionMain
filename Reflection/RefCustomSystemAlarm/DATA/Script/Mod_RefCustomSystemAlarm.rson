      "Operations":      
      [
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -50,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  5,
          "Code.Type":  "Global",
          "Code":          
          [
              "if(!GCntRun(GScriptName)) GRun();"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  0,
          "Pos.y":  -90,
          "Parent":  -1,
          "#":  6,
          "Code.Type":  "DialogBegin",
          "Code":          
          [
              "if(FlagCount == 0) {",
              "    temp_str_main = \"<clr>Отключены<clrEnd>\";",
              "}",
              "if(FlagCount == 1) {",
              "    temp_str_main = \"Система\"+' ' + temp_str1;",
              "}",
              "if(FlagCount == 2) {",
              "    temp_str_main = \"Cистемы\"+' ' + temp_str1 + ' '+\"и\"+' ' + temp_str2;",
              "}",
              "if(FlagCount == 3) temp_str_main = \"Системы\"+' ' + temp_str1 + ', ' + temp_str2 + ' '+\"и\"+' ' + temp_str3;",
              "AddDialogInject('AlarmDialog',\"Уведомления об атаках:\"+' ' + temp_str_main,\"Управление оповещениями об атаке систем\",19);"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  100,
          "Pos.y":  90,
          "Parent":  -1,
          "#":  27,
          "Code.Type":  "Turn",
          "Code":          
          [
              "//Удаление системы №1: остальные сдвигаются вверх",
              "//(раньше при 2 системах в №1 попадал Id пустой №3 = 0 -> на следующем ходу IdToPlanet(0) -> вылет)",
              "IDOne = IDTwo;",
              "temp_str1 = temp_str2;",
              "cd1 = cd2;",
              "IDTwo = IDThree;",
              "temp_str2 = temp_str3;",
              "cd2 = cd3;",
              "IDThree = 0;",
              "temp_str3 = \"Не выбрана\";",
              "cd3 = 0;",
              "FlagCount = FlagCount - 1;",
              "if(FlagCount < 2) temp_str2 = \"Не выбрана\";",
              "if(FlagCount < 1) temp_str1 = \"Не выбрана\";"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  200,
          "Pos.y":  90,
          "Parent":  -1,
          "#":  28,
          "Code.Type":  "Turn",
          "Code":          
          [
              "//Удаление системы №2: №3 сдвигается вверх",
              "IDTwo = IDThree;",
              "temp_str2 = temp_str3;",
              "cd2 = cd3;",
              "IDThree = 0;",
              "temp_str3 = \"Не выбрана\";",
              "cd3 = 0;",
              "FlagCount = FlagCount - 1;",
              "if(FlagCount < 2) temp_str2 = \"Не выбрана\";"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  300,
          "Pos.y":  90,
          "Parent":  -1,
          "#":  29,
          "Code.Type":  "Turn",
          "Code":          
          [
              "IDThree = 0;",
              "temp_str3 = \"Не выбрана\";",
              "cd3 = 0;",
              "FlagCount = FlagCount - 1;"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  250,
          "Pos.y":  190,
          "Parent":  -1,
          "#":  32,
          "Code.Type":  "Turn",
          "Code":          
          [
              "for(i = 0;GalaxySectors() > i;i = i + 1) {",
              "    if(!SectorVisible(GalaxySectors(i))) continue;",
              "    InjectAnswer('DialogSector',Name(GalaxySectors(i)),GalaxySectors(i));",
              "}",
              "InjectAnswer('AlarmDialog',\"Назад\",0);"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  440,
          "Pos.y":  -60,
          "Parent":  -1,
          "#":  39,
          "Code.Type":  "Turn",
          "Code":          
          [
              "temp_dword = GAnswerData;",
              "temp_str_local = Name(temp_dword);"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  440,
          "Pos.y":  20,
          "Parent":  -1,
          "#":  43,
          "Code.Type":  "Turn",
          "Code":          
          [
              "for(i = 0;ConStars(temp_dword) > i;i = i + 1) {",
              "    alarm_star = ConStar(temp_dword,i);",
              "    if(alarm_star == ShipStatistic(Player(),10)) continue;",
              "    if(StarEnemyThreatLevel(alarm_star,1) > 1) continue;",
              "    //Система отслеживается по её планете: без планет нельзя (раньше Id(0) -> вылет)",
              "    if(StarPlanets(alarm_star) < 1) continue;",
              "    //Уже выбранные не предлагать",
              "    if(FlagCount >= 1 && IDOne > 0) {",
              "        if(PlanetToStar(IdToPlanet(IDOne)) == alarm_star) continue;",
              "    }",
              "    if(FlagCount >= 2 && IDTwo > 0) {",
              "        if(PlanetToStar(IdToPlanet(IDTwo)) == alarm_star) continue;",
              "    }",
              "    InjectAnswer('DialogSystems',Name(alarm_star),alarm_star);",
              "}",
              "InjectAnswer('AlarmDialog',\"Назад\",0);"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  500,
          "Pos.y":  -60,
          "Parent":  -1,
          "#":  44,
          "Code.Type":  "Turn",
          "Code":          
          [
              "temp_dword = GAnswerData;",
              "temp_str_local = Name(GAnswerData);"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  500,
          "Pos.y":  20,
          "Parent":  -1,
          "#":  47,
          "Code.Type":  "Turn",
          "Code":          
          [
              "InjectAnswer('AlarmDialog',\"Назад\",0);"          
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  -50,
          "Pos.y":  -140,
          "Parent":  -1,
          "#":  48,
          "Code.Type":  "Turn",
          "Code":          
          [
              "//cd1..cd3 - переменные скрипта (раньше int внутри кода хода обнулялись каждый ход -> «идёт сражение» ежедневно)",
              "if(cd1 > 0) cd1 = cd1 - 1;",
              "if(cd2 > 0) cd2 = cd2 - 1;",
              "if(cd3 > 0) cd3 = cd3 - 1;",
              "//Пустые слоты (Id 0 в старых сейвах после ошибки удаления) убираются: IdToPlanet(0) -> вылет",
              "if(FlagCount >= 3 && IDThree < 1) {",
              "    IDThree = 0;",
              "    temp_str3 = \"Не выбрана\";",
              "    cd3 = 0;",
              "    FlagCount = 2;",
              "}",
              "if(FlagCount >= 2 && IDTwo < 1) {",
              "    IDTwo = IDThree;",
              "    temp_str2 = temp_str3;",
              "    cd2 = cd3;",
              "    IDThree = 0;",
              "    temp_str3 = \"Не выбрана\";",
              "    cd3 = 0;",
              "    FlagCount = FlagCount - 1;",
              "}",
              "if(FlagCount >= 1 && IDOne < 1) {",
              "    IDOne = IDTwo;",
              "    temp_str1 = temp_str2;",
              "    cd1 = cd2;",
              "    IDTwo = IDThree;",
              "    temp_str2 = temp_str3;",
              "    cd2 = cd3;",
              "    IDThree = 0;",
              "    temp_str3 = \"Не выбрана\";",
              "    cd3 = 0;",
              "    FlagCount = FlagCount - 1;",
              "}",
              "if(FlagCount < 2) temp_str2 = \"Не выбрана\";",
              "if(FlagCount < 1) temp_str1 = \"Не выбрана\";",
              "//С конца: удаление слота сдвигает только уже проверенные.",
              "//Захват (в т.ч. пиратами) - маркер 1, как при выборе системы и проверке боя; раньше сдвиг писал №3 в №1",
              "if(FlagCount >= 3) {",
              "    alarm_star = PlanetToStar(IdToPlanet(IDThree));",
              "    alarm_lev = StarEnemyThreatLevel(alarm_star,1);",
              "    if(alarm_lev == 3) {",
              "        CustomEther('Galaxy_Alert',0,'',\"Внимание!!! Система <temp_str3> была захвачена. Слежение за системой прекращено\");",
              "        IDThree = 0;",
              "        temp_str3 = \"Не выбрана\";",
              "        cd3 = 0;",
              "        FlagCount = FlagCount - 1;",
              "    }",
              "    else if(alarm_lev == 2 && cd3 == 0) {",
              "        cd3 = 15;",
              "        CustomEther('Galaxy_Alert',0,'',\"Внимание!!! В системе <temp_str3> идёт сражение!\");",
              "    }",
              "}",
              "if(FlagCount >= 2) {",
              "    alarm_star = PlanetToStar(IdToPlanet(IDTwo));",
              "    alarm_lev = StarEnemyThreatLevel(alarm_star,1);",
              "    if(alarm_lev == 3) {",
              "        CustomEther('Galaxy_Alert',0,'',\"Внимание!!! Система <temp_str2> была захвачена. Слежение за системой прекращено\");",
              "        IDTwo = IDThree;",
              "        temp_str2 = temp_str3;",
              "        cd2 = cd3;",
              "        IDThree = 0;",
              "        temp_str3 = \"Не выбрана\";",
              "        cd3 = 0;",
              "        FlagCount = FlagCount - 1;",
              "    }",
              "    else if(alarm_lev == 2 && cd2 == 0) {",
              "        cd2 = 15;",
              "        CustomEther('Galaxy_Alert',0,'',\"Внимание!!! В системе <temp_str2> идёт сражение!\");",
              "    }",
              "}",
              "if(FlagCount >= 1) {",
              "    alarm_star = PlanetToStar(IdToPlanet(IDOne));",
              "    alarm_lev = StarEnemyThreatLevel(alarm_star,1);",
              "    if(alarm_lev == 3) {",
              "        CustomEther('Galaxy_Alert',0,'',\"Внимание!!! Система <temp_str1> была захвачена. Слежение за системой прекращено\");",
              "        IDOne = IDTwo;",
              "        temp_str1 = temp_str2;",
              "        cd1 = cd2;",
              "        IDTwo = IDThree;",
              "        temp_str2 = temp_str3;",
              "        cd2 = cd3;",
              "        IDThree = 0;",
              "        temp_str3 = \"Не выбрана\";",
              "        cd3 = 0;",
              "        FlagCount = FlagCount - 1;",
              "    }",
              "    else if(alarm_lev == 2 && cd1 == 0) {",
              "        cd1 = 15;",
              "        CustomEther('Galaxy_Alert',0,'',\"Внимание!!! В системе <temp_str1> идёт сражение!\");",
              "    }",
              "}",
              "if(FlagCount < 2) temp_str2 = \"Не выбрана\";",
              "if(FlagCount < 1) temp_str1 = \"Не выбрана\";"
          ]        
        },
        {
          "Type":  "Top",
          "Name":  "",
          "Pos.x":  500,
          "Pos.y":  100,
          "Parent":  -1,
          "#":  50,
          "Code.Type":  "Turn",
          "Code":          
          [
              "//Планета №0 (раньше №1 - вторая; в системе с одной планетой получался Id 0 -> вылет)",
              "if(FlagCount == 0) {",
              "    IDOne = Id(StarPlanets(temp_dword,0));",
              "}",
              "if(FlagCount == 1) {",
              "    IDTwo = Id(StarPlanets(temp_dword,0));",
              "}",
              "if(FlagCount == 2) {",
              "    IDThree = Id(StarPlanets(temp_dword,0));",
              "}",
              "if(FlagCount == 0) {",
              "    temp_str1 = temp_str_local;",
              "}",
              "if(FlagCount == 1) {",
              "    temp_str2 = temp_str_local;",
              "}",
              "if(FlagCount == 2) {",
              "    temp_str3 = temp_str_local;",
              "}",
              "FlagCount = FlagCount + 1;"
          ]        
        }      
      ],
