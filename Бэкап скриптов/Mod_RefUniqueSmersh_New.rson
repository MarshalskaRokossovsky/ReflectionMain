            "Operations": 
            [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -22,
                    "Pos.y": -89,
                    "Parent": -1,
                    "#": 5,
                    "Code.Type": "Global",
                    "Code": 
                    [
                        "GRun();",
                        "if(Bought >= 1) {",
                        "    if(ItemExist(Hornet)) {",
                        "        ItemOnUseCode(Hornet,GenerateCodeStringFromBlock('ShipInfo.AddInfo.CustomInfos.RefSmershMainInfo.OnUseCode'));",
                        "        ItemOnActCode(Hornet,'[t_OnDealingDamage,t_OnStep|0]'+GenerateCodeStringFromBlock('ShipInfo.AddInfo.CustomInfos.RefSmershMainInfo.OnActCode'));",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": -89,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "DialogBegin",
                    "Code": 
                    [
                        "if(ShipRank(Player()) >= 4 && !ShipOnSidePirateClan(Player()) && GalaxyDominatorResearchPercent() > 25) {",
                        "    if(GetShipRuins(Player())) {",
                        "        if(ShipType(GetShipRuins(Player())) == 'SB') {",
                        "            if(Bought < 1 && !CurrentMods('Evolution\\\\EvoSB')) {",
                        "                AddDialogInject('SmershBuy', \"Не хотите взглянуть на результат работы спецотдела Коалиции и специалистов в сфере прикладной доминаторологии? Мы готовы дать доступ вам как отличившемуся бойцу Коалиции\", \"А что это у вас там за доминаторология?\", 34);",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "temp_int = (round(round((110 - GalaxyDominatorResearchPercent())*5500) + GalaxyDiffLevels()*1000 + Rnd(3000,9000)))*max(1,Bought);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 70,
                    "Parent": -1,
                    "#": 16,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "ShipMoney(Player(),ShipMoney(Player()) - temp_int);",
                        "temp_dword = CreateHull(1,350+GalaxyTechLevel()*200,GalaxyTechLevel(),Kling,-1);",
                        "SpecialToEquipment(FindBonusByNameInCfg('RefUniqueSmersh_Keller'),temp_dword);",
                        "if(HullSpecial(temp_dword) != FindBonusByNameInCfg('RefUniqueSmersh_Keller')) {",
                        "    ShipMoney(Player(),ShipMoney(Player()) + temp_int);",
                        "    ItemDestroy(temp_dword,1);",
                        "    MessageBox('Ошибка создания корпуса: не найден режим Keller. Проверьте Lang.dat мода.');",
                        "    exit;",
                        "}",
                        "AddItemToStorage(GetShipRuins(Player()),temp_dword);",
                        "ItemCost(temp_dword,temp_int/2);",
                        "Sound('Sound.Buy');",
                        "LinkItemToScript(temp_dword,Hornet);",
                        "if(Bought < 1) Bought = 1;",
                        "Bought = Bought + 0.2;",
                        "ItemOnUseCode(temp_dword,GenerateCodeStringFromBlock('ShipInfo.AddInfo.CustomInfos.RefSmershMainInfo.OnUseCode'));",
                        "ItemOnActCode(temp_dword,'[t_OnDealingDamage,t_OnStep|0]'+GenerateCodeStringFromBlock('ShipInfo.AddInfo.CustomInfos.RefSmershMainInfo.OnActCode'));"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 20,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "DialogBegin",
                    "Code": 
                    [
                        "temp_dword = HullSpecial(Player());",
                        "if(temp_dword == FindBonusByNameInCfg('RefUniqueSmersh_Keller') || temp_dword == FindBonusByNameInCfg('RefUniqueSmersh_Terron') || temp_dword == FindBonusByNameInCfg('RefUniqueSmersh_Blazer')) {",
                        "    if(temp_dword == FindBonusByNameInCfg('RefUniqueSmersh_Keller'))",
                        "    {",
                        "        temp_str=\"Keller\";",
                        "        AddDialogInject('SwitchOnTerron',\"Текущий режим: <temp_str>\",\"Переключить Шершень на режим Terron\",17);",
                        "    }",
                        "    if(temp_dword == FindBonusByNameInCfg('RefUniqueSmersh_Terron'))",
                        "    {",
                        "        temp_str=\"Terron\";",
                        "        AddDialogInject('SwitchOnBlazer',\"Текущий режим: <temp_str>\",\"Переключить Шершень на режим Blazer\",17);",
                        "    }",
                        "    if(temp_dword == FindBonusByNameInCfg('RefUniqueSmersh_Blazer'))",
                        "    {",
                        "        temp_str=\"Blazer\";",
                        "        AddDialogInject('SwitchOnKeller',\"Текущий режим: <temp_str>\",\"Переключить Шершень на режим Keller\",17);",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 260,
                    "Pos.y": 0,
                    "Parent": -1,
                    "#": 24,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "temp_dword = HullHP(Player());",
                        "SwitchToMirrorImage(Player(),FindBonusByNameInCfg('RefUniqueSmersh_Keller'));",
                        "Sound('Sound.ButtonInfoEnter');",
                        "HullHP(Player(),temp_dword);",
                        "DAnswer('main');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 0,
                    "Parent": -1,
                    "#": 25,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "temp_dword = HullHP(Player());",
                        "SwitchToMirrorImage(Player(),FindBonusByNameInCfg('RefUniqueSmersh_Terron'));",
                        "Sound('Sound.ButtonInfoEnter');",
                        "HullHP(Player(),temp_dword);",
                        "DAnswer('main');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 340,
                    "Pos.y": 0,
                    "Parent": -1,
                    "#": 30,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "temp_dword = HullHP(Player());",
                        "SwitchToMirrorImage(Player(),FindBonusByNameInCfg('RefUniqueSmersh_Blazer'));",
                        "Sound('Sound.ButtonInfoEnter');",
                        "HullHP(Player(),temp_dword);",
                        "DAnswer('main');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -250,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 35,
                    "Code.Type": "DialogBegin",
                    "Code": 
                    [
                        "if(GetShipPirateRank(Player()) >= 4 && ShipOnSidePirateClan(Player()) && GalaxyDominatorResearchPercent() > 25) {",
                        "    if(GetShipRuins(Player())) {",
                        "        if(ShipType(GetShipRuins(Player())) == 'CB') {",
						"            if(Bought >= 1 && PhantomUpgraded == 0 && !CurrentMods('Evolution\\\\EvoSB')) {",
                        "                AddDialogInject('CB_PhantomBuy', \"\", \"Слушай, у меня тут есть уникальный коалиционный корпус. Слышал, ваши парни могут его как-то улучшить?\", 1);",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -213,
                    "Pos.y": -87,
                    "Parent": -1,
                    "#": 38,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "temp_int = (round(round((110 - GalaxyDominatorResearchPercent())*5500) + GalaxyDiffLevels()*1000 + Rnd(3000,9000)))*max(1,Bought);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -212,
                    "Pos.y": 53,
                    "Parent": -1,
                    "#": 43,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "ShipMoney(Player(), ShipMoney(Player()) - temp_int);",
                        "",
                        "for(phantom_i=ShipItems(Player())-1; phantom_i>=0; phantom_i=phantom_i-1) {",
                        "    phantom_itm = ShipItems(Player(), phantom_i);",
                        "",
                        "    // Ищем любой из режимов Шершня",
                        "    if(HullSpecial(phantom_itm) == FindBonusByNameInCfg('RefUniqueSmersh_Keller') || HullSpecial(phantom_itm) == FindBonusByNameInCfg('RefUniqueSmersh_Terron') || HullSpecial(phantom_itm) == FindBonusByNameInCfg('RefUniqueSmersh_Blazer')) {",
                        "",
                        "        // Перепрошиваем корпус в Фантом",
                        "        SpecialToEquipment(FindBonusByNameInCfg('RefUniqueSmersh_Phantom'), phantom_itm);",
						"        ItemOwner(phantom_itm, PirateClan);",
                        "        ItemCost(phantom_itm, ItemCost(phantom_itm) + (temp_int / 2));",
                        "",
                        "        // ТРЮК: Проверяем, надет ли этот корпус на игрока прямо сейчас?",
                        "        if(HullSpecial(Player()) == FindBonusByNameInCfg('RefUniqueSmersh_Phantom')) {",
                        "            // Сохраняем прочность (чтобы игра не вылечила или не сломала корпус при смене визуала)",
                        "            temp_dword = HullHP(Player());",
                        "            // Принудительно обновляем внешний вид корабля!",
                        "            SwitchToMirrorImage(Player(), FindBonusByNameInCfg('RefUniqueSmersh_Phantom'));",
                        "            HullHP(Player(), temp_dword);",
                        "        }",
                        "",
                        "        Sound('Sound.Buy');",
						"		 PhantomUpgraded = 1;",
                        "        break;",
                        "    }",
                        "}"
                    ]
                }
            ],
